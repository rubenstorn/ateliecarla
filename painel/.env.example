# Copie este arquivo para "painel/.env" e preencha os dois valores.
#
# Onde achar: painel do Supabase › Project Settings › API
#   VITE_SUPABASE_URL      = Project URL
#   VITE_SUPABASE_ANON_KEY = chave "anon public"
#
# ⛔ NUNCA coloque aqui a chave "service_role". Ela ignora toda a
#    segurança do banco e só serve para uso em servidor.
#
# O prefixo VITE_ é obrigatório: o Vite só entrega ao navegador as
# variáveis que começam assim. Nenhuma outra vaza para o pacote final.
#
# O arquivo .env NÃO vai para o git (está no .gitignore).

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=COLE_AQUI_A_CHAVE_ANON
